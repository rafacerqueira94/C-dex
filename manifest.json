{
  "manifest_version": 3,
  "name": "Ponte Centi — consulta e conferência",
  "version": "0.7.2",
  "description": "Lê o cartão CNPJ em PDF e apresenta os serviços para conferência.",
  "background": {
    "service_worker": "worker.js"
  },
  "action": {
    "default_title": "Ler cartão CNPJ em PDF"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self'; worker-src 'self'"
  }
}
